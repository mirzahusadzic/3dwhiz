CC = gcc
CFLAGS = $(OPT) $(WARN)
SHARED_CFLAGS = -fpic

CXX = g++
CXXFLAGS = $(CFLAGS)
SHARED_CXXFLAGS = $(SHARED_CFLAGS)

LDFLAGS =
SHARED_LDFLAGS = -shared -rdynamic -Wl,-zdefs

COMPILE = $(CC) $(CPPFLAGS) $(CFLAGS)
COMPILEXX = $(CXX) $(CPPFLAGS) $(CXXFLAGS)
COMPILE_SHARED = $(CC) $(CPPFLAGS) $(CFLAGS) $(SHARED_CFLAGS)
COMPILEXX_SHARED = $(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SHARED_CXXFLAGS)

LINK = $(CC) $(CFLAGS) $(LDFLAGS) $(LIBS)
LINKXX = $(CXX) $(CXXFLAGS) $(LDFLAGS) $(LIBS)
LINK_SHARED = $(CC) $(CFLAGS) $(SHARED_CFLAGS) $(LDFLAGS) $(SHARED_LDFLAGS) $(LIBS)
LINKXX_SHARED = $(CXX) $(CXXFLAGS) $(SHARED_CXXFLAGS) $(LDFLAGS) $(SHARED_LDFLAGS) $(LIBS)


%.dep: %.c Makefile
ifndef DUMMY_DEPS
	$(CC) $(CPPFLAGS) -MM $< -MF $@
else
	touch $@
endif

%.dep: %.cpp Makefile
ifndef DUMMY_DEPS
	$(CXX) $(CPPFLAGS) -MM $< -MF $@
else
	touch $@
endif
